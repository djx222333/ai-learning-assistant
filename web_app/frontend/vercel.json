{
  "$schema": "https://raw.githubusercontent.com/vercel/vercel/main/packages/vercel-json/schema.json",
  "name": "ai-learning-assistant",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "devCommand": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://$RAILWAY_PUBLIC_DOMAIN/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, immutable, max-age=31536000"
        }
      ]
    }
  ],
  "github": {
    "silent": true
  }
}
